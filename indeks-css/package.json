{
    "name": "@sb1/indeks-css",
    "version": "0.23.0",
    "description": "CSS library for Indeks design system",
    "main": "dist/npm/index.css",
    "type": "module",
    "homepage": "https://design.sparebank1.no",
    "repository": {
        "type": "git",
        "url": "https://github.com/SpareBank1/indeks",
        "directory": "indeks-css"
    },
    "bugs": {
        "url": "https://github.com/SpareBank1/indeks/issues"
    },
    "keywords": [
        "indeks",
        "design-system",
        "css",
        "styles",
        "components",
        "sparebank1"
    ],
    "exports": {
        ".": "./dist/npm/index.css",
        "./tailwind.css": "./dist/npm/tailwind.css"
    },
    "files": [
        "dist/npm",
        "CHANGELOG.md",
        "README.md"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "rm -rf ./dist && pnpm run build:npm && pnpm run build:tailwind",
        "build:npm": "rm -rf ./dist/npm && postcss ./index.css -o ./dist/npm/index.css",
        "build:tailwind": "postcss ./tailwind.css -o ./dist/npm/tailwind.css",
        "build:cdn": "rm -rf ./dist/cdn && postcss ./css/index.css -o ./dist/cdn/components.css --env cdn && postcss ./index.css -o ./dist/cdn/index.css --env cdn",
        "lint": "stylelint \"css/**/*.css\" && node ../scripts/check-css-variables.js ."
    },
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@sb1/indeks-tokens": "workspace:*",
        "@sb1/indeks-utils": "workspace:*",
        "autoprefixer": "^10.6.1",
        "cssnano": "^9.0.5",
        "postcss": "^8.5.28",
        "postcss-cli": "^11.0.1",
        "postcss-import": "^17.0.0",
        "postcss-preset-env": "^11.5.3"
    }
}
