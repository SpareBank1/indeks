{
    "name": "@sb1/indeks-eksempel",
    "private": true,
    "license": "MIT",
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "npm run cp:themes && vite --open",
        "build": "tsc --noEmit && npm run cp:themes && vite build",
        "cp:themes": "mkdir -p ./public/themes && cp -r ../indeks-tokens/.build/css/themes/* ./public/themes && node ../indeks-tokens/dist/cli.js build-colors platform=web path=./.theme-build theme=./themes/kredittbanken.json && cp ./.theme-build/themes/kredittbanken.css ./public/themes/",
        "lint": "oxlint -c ../.oxlintrc.json . && node ../scripts/check-css-variables.js .",
        "update-packages": "npx npm-check-updates -i --format group",
        "preview": "vite preview",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "docker:run-e2e": "docker compose run --rm playwright",
        "test:e2e:docker": "pnpm run build && pnpm run docker:run-e2e"
    },
    "dependencies": {
        "@hookform/resolvers": "6.0.0",
        "@sb1/indeks-css": "workspace:*",
        "@sb1/indeks-react": "workspace:*",
        "@sb1/indeks-tokens": "workspace:*",
        "@sb1/indeks-utils": "workspace:*",
        "@sb1/indeks-web": "workspace:*",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-hook-form": "7.91.0",
        "react-router-dom": "^7.18.4",
        "valibot": "1.5.0"
    },
    "devDependencies": {
        "@playwright/test": "1.64.1",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "debug": "^4.4.3",
        "typescript": "~6.0.3",
        "vite": "^8.3.5"
    }
}
