{
    "name": "@sb1/indeks-eksempel",
    "private": true,
    "license": "MIT",
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "npm run cp:themes && vite --open",
        "build": "tsc --noEmit && npm run cp:themes && vite build",
        "cp:themes": "mkdir -p ./public/themes && cp -r ../indeks-tokens/.build/css/themes/* ./public/themes",
        "lint": "eslint .",
        "update-packages": "npx npm-check-updates -i --format group",
        "preview": "vite preview",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "docker:run-e2e": "docker compose run --name eksempel-e2e playwright; docker cp eksempel-e2e:/repo/indeks-eksempel/playwright-report playwright-report 2>/dev/null; docker cp eksempel-e2e:/repo/indeks-eksempel/test-results test-results 2>/dev/null; docker rm eksempel-e2e",
        "docker:fix-ownership": "docker run --rm -v .:/target alpine chown -R $(id -u) /target/playwright-report /target/test-results 2>/dev/null; true",
        "test:e2e:docker": "pnpm run build && pnpm run docker:run-e2e; pnpm run docker:fix-ownership"
    },
    "dependencies": {
        "@hookform/resolvers": "5.4.0",
        "@sb1/indeks-react": "workspace:*",
        "@sb1/indeks-web": "workspace:*",
        "clsx": "^2.1.1",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-hook-form": "7.82.0",
        "react-router-dom": "^7.18.1",
        "valibot": "1.4.2"
    },
    "devDependencies": {
        "@playwright/test": "1.61.1",
        "@types/node": "^26.0.1",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.3",
        "debug": "^4.4.3",
        "eslint-plugin-react-refresh": "^0.5.3",
        "typescript": "~6.0.3",
        "vite": "^8.1.5"
    }
}
