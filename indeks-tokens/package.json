{
    "name": "@sb1/indeks-tokens",
    "version": "0.8.1",
    "description": "Design tokens for Indeks design system",
    "type": "module",
    "homepage": "https://design.sparebank1.no",
    "repository": {
        "type": "git",
        "url": "https://github.com/SpareBank1/indeks",
        "directory": "indeks-tokens"
    },
    "bugs": {
        "url": "https://github.com/SpareBank1/indeks/issues"
    },
    "keywords": [
        "indeks",
        "design-system",
        "tokens",
        "design-tokens",
        "css",
        "sparebank1"
    ],
    "main": "dist/index.css",
    "exports": {
        ".": "./dist/index.css",
        "./generate": {
            "types": "./dist/scripts/build-colors/generate.d.ts",
            "import": "./dist/generate.js"
        }
    },
    "bin": {
        "indeks-tokens": "./dist/cli.js"
    },
    "files": [
        "dist",
        "CHANGELOG.md",
        "README.md"
    ],
    "publishConfig": {
        "access": "public"
    },
    "directories": {
        "lib": "lib"
    },
    "scripts": {
        "dev": "echo not implemented",
        "build": "rm -rf ./dist ./.build && pnpm run build:tokens:css && pnpm run build:colors:web && pnpm run build:colors:figma && pnpm run build:bundle && pnpm run build:cli && pnpm run build:generate && pnpm run build:types",
        "build:cli": "pnpm exec esbuild scripts/build-colors/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.js --banner:js='#!/usr/bin/env node' --define:__PKG_VERSION__=\"\\\"$npm_package_version\\\"\"",
        "build:generate": "pnpm exec esbuild scripts/build-colors/generate.ts --bundle --platform=neutral --format=esm --outfile=dist/generate.js",
        "build:types": "pnpm exec tsc -p tsconfig.generate.json",
        "build:spacing": "node ./scripts/build-spacing-tokens.cjs",
        "test": "vitest run buildThemeColors.test.ts cli.integration.test.ts generate.test.ts",
        "build:colors:web": "tsx ./scripts/build-colors/index platform=web path=./.build/css",
        "build:colors:figma": "tsx ./scripts/build-colors/index platform=figma path=./tokens/colors/from-code",
        "build:colors:ios": "tsx ./scripts/build-colors/index platform=ios path=./dist/ios",
        "build:colors:android": "tsx ./scripts/build-colors/index platform=android path=./dist/android",
        "sync": "sh scripts/figma-api/sync.sh",
        "update-packages": "ncu -i --format group",
        "build:tokens:css": "tsx scripts/build-tokens/index.ts platform=css path=./.build/css",
        "build:bundle": "postcss ./.build/css/index.css -o ./dist/index.css"
    },
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@figma/rest-api-spec": "^0.42.0",
        "typescript": "~6.0.3",
        "@types/node": "^26.2.0",
        "autoprefixer": "^10.5.4",
        "colorjs.io": "^0.7.1",
        "cssnano": "^8.0.6",
        "dotenv": "^17.4.2",
        "esbuild": "0.28.2",
        "postcss": "^8.5.26",
        "postcss-cli": "^11.0.1",
        "postcss-import": "^16.2.0",
        "postcss-preset-env": "^11.4.0",
        "tsx": "^4.23.12",
        "typescript": "~6.0.3",
        "vitest": "^4.1.10"
    }
}
